@model CinemasVM

@section Scripts {
    <partial name="_NotificationPartial.cshtml" />
}

<div class="row g-3 mb-3">
    <div class="col-xxl-6 col-xl-12">
        <div class="row g-3">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="row flex-between-end">
                            <div class="col-auto align-self-center">
                                <h5 class="mb-0" data-anchor="data-anchor">Cinema Table</h5>
                                <p class="mb-0 pt-1 mt-2 mb-0">Using the most basic table markup, here’s how <code> .table </code> based tables look in Bootstrap.</p>
                            </div>
                            <div class="col-auto ms-auto">
                                <a href="/Admin/Cinema/Create" class="btn btn-falcon-success btn-sm" type="button"><span class="fas fa-plus" data-fa-transform="shrink-3 down-2"></span><span class="ms-1">New</span></a>
                            </div>
                        </div>
                    </div>
                    <div class="card-body pt-0">
                        <div class="tab-content">
                            <div class="tab-pane preview-tab-pane active" role="tabpanel" aria-labelledby="tab-dom-312058a7-65a3-45e8-89e9-d16cd165bba0" id="dom-312058a7-65a3-45e8-89e9-d16cd165bba0">
                                <div class="row justify-content-end g-0">
                                    <div class="col-auto col-sm-5 mb-3">
                                        <form method="get" asp-area="Admin" asp-controller="Cinema" asp-action="Index">
                                            <div class="input-group">
                                                <input class="form-control form-control-sm shadow-none"
                                                       type="search"
                                                       name="name"
                                                       value="@Context.Request.Query["name"]"
                                                       placeholder="Search..." />

                                                <button type="submit" class="input-group-text bg-transparent border-0">
                                                    <span class="fa fa-search fs--1 text-600"></span>
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                                <div class="table-responsive scrollbar">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th scope="col">No.</th>
                                                <th scope="col">Img</th>
                                                <th scope="col">Name</th>
                                                <th scope="col">Status</th>
                                                <th class="text-end" scope="col">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.Cinemas)
                                            {
                                                <tr>
                                                    <td>@item.Id</td>
                                                    <td>
                                                        <div class="avatar avatar-5xl">
                                                            <img class="rounded-soft" src="~/img/cinema_imgs/@item.Img" alt="" />
                                                        </div>
                                                    </td>
                                                    <td>@item.Name</td>
                                                    <td>
                                                        @if (item.Status)
                                                        {
                                                            <span class="badge badge rounded-pill d-block p-2 badge-soft-success">Active</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge rounded-pill d-block p-2 badge-soft-warning">Not Active</span>
                                                        }
                                                    </td>
                                                    <td class="text-end">
                                                        <div>
                                                            <a href="/Admin/Cinema/Edit/@item.Id" class="btn btn-link p-0" type="button" data-bs-toggle="tooltip" data-bs-placement="top" title="Edit"><span class="text-500 fas fa-edit"></span></a>
                                                            <a href="/Admin/Cinema/Delete/@item.Id" class="btn btn-link p-0 ms-2 btn-delete" type="button" data-bs-toggle="tooltip" data-bs-placement="top" title="Delete"><span class="text-500 fas fa-trash-alt"></span></a>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <nav aria-label="Page navigation example">
                                    <ul class="pagination justify-content-center">
                                        @if (Model.CurrentPage > 1)
                                        {
                                            <li class="page-item"><a class="page-link" href="/Admin/Cinema/Index?page=@(Model.CurrentPage - 1)" tabindex="-1" aria-disabled="true">Previous</a></li>
                                        }
                                        @for (int i = 1; i <= Model.TotalPages; i++)
                                        {
                                            @if (i == Model.CurrentPage)
                                            {
                                                <li class="page-item active"><a class="page-link" href="/Admin/Cinema/Index?page=@i&name=@Context.Request.Query["name"]">@i</a></li>
                                            }
                                            else
                                            {
                                                <li class="page-item"><a class="page-link" href="/Admin/Cinema/Index?page=@i&name=@Context.Request.Query["name"]">@i</a></li>
                                            }
                                        }
                                        @if (Model.CurrentPage < Model.TotalPages)
                                        {
                                            <li class="page-item"><a class="page-link" href="/Admin/Cinema/Index?page=@(Model.CurrentPage + 1)">Next</a></li>
                                        }
                                    </ul>
                                </nav>
                            </div>
                            <div class="tab-pane code-tab-pane" role="tabpanel" aria-labelledby="tab-dom-e56f01fd-0875-4d42-84fa-cc29d6354804" id="dom-e56f01fd-0875-4d42-84fa-cc29d6354804">

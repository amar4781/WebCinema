@model MovieWithRelatedVM

@{
    ViewData["Title"] = "Details of Movies";
}

@section Scripts {
    <partial name="_NotificationPartial.cshtml" />
}

<style>
    /* نخلي العنصر الأساسي مرجع للـ dropdown */
    .main-navigation .menu .has-dropdown {
        position: relative;
    }

    /* شكل القائمة المنسدلة */
    .main-navigation .menu .sub-menu {
        position: absolute;
        top: 120%;
        left: 0;
        background: #fff;
        list-style: none;
        padding: 10px 0;
        margin: 0;
        min-width: 180px;
        border-radius: 4px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        display: none;
        z-index: 999;
    }

        /* عناصر القائمة */
        .main-navigation .menu .sub-menu li {
            padding: 0;
        }

            .main-navigation .menu .sub-menu li a {
                display: block;
                padding: 8px 15px;
                color: #666;
                text-decoration: none;
                font-size: 14px;
            }

                /* Hover */
                .main-navigation .menu .sub-menu li a:hover {
                    background: #f5f5f5;
                    color: #2ecc71; /* نفس الأخضر بتاع التمبلت */
                }

    /* إظهار عند الـ hover */
    .main-navigation .menu .has-dropdown:hover .sub-menu {
        display: block;
    }

    /* نخلي العناصر تحت بعض */
    .main-navigation .menu .sub-menu li {
        display: block;
        width: 100%;
    }

        /* نشيل أي تنسيق inline من اللينكات */
        .main-navigation .menu .sub-menu li a {
            display: block;
            width: 100%;
        }

        .main-navigation .menu .sub-menu li:after {
            display: none !important;
        }
</style>

<div class="site-header">
    <div class="container">
        <div class="main-navigation">
            <button class="toggle-menu"><i class="fa fa-bars"></i></button>
            <ul class="menu">
                <li class="menu-item home current-menu-item"><a href="index.html"><i class="icon-home"></i></a></li>
                <li class="menu-item has-dropdown">
                    <a href="#">Categories</a>
                    <ul class="sub-menu">
                        @foreach (var item in Model.Categories)
                        {
                            <li><a href="/Customer/Home/Index?categoryId=@item.Id">@item.Name</a></li>
                        }
                    </ul>
                </li>
                <li class="menu-item"><a href="#">Promotions</a></li>
                <li class="menu-item"><a href="#">PC</a></li>
                <li class="menu-item"><a href="#">Playstation</a></li>
                <li class="menu-item"><a href="#">Xbox</a></li>
                <li class="menu-item"><a href="#">Wii</a></li>
            </ul> <!-- .menu -->
            <div class="search-form">
                <label><img src="~/customer/images/icon-search.png"></label>
                <input type="text" placeholder="Search...">
            </div> <!-- .search-form -->

            <div class="mobile-navigation"></div> <!-- .mobile-navigation -->
        </div> <!-- .main-navigation -->
    </div>
</div>


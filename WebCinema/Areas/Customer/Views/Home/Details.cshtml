<main class="main-content">
    <div class="container">
        <div class="page">

            <div class="entry-content">
                <div class="row">
                    <div class="col-sm-6 col-md-4">
                        <div class="product-images">
                            <figure class="large-image">
                                <a href="dummy/image-1.jpg"><img src="~/img/movie_imgs/@Model.Movie.MainImg" alt=""></a>
                            </figure>
                            <div class="thumbnails">
                                @foreach (var item in Model.MovieSubImgs)
                                {
                                    <a href="#"><img src="~/img/movie_imgs/sub_images/@item.SubImg" alt=""></a>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-8">
                        <h2 class="entry-title">@Model.Movie.Name</h2>
                        <small class="price">@Model.Movie.Price.ToString("c")</small>

                        <p>@Model.Movie.Description</p>

                        <div class="addtocart-bar">
                            <form asp-action="AddToCart" asp-controller="Cart">
                                <input type="hidden" name="movieId" value="@Model.Movie.Id"/>
                                <label for="#">Quantity</label>
                                <input type="number" name="count"/>
                                <button type="submit">Add to cart</button>
                            </form>

                            <div class="social-links square">
                                <strong>Share</strong>
                                <a href="#" class="facebook"><i class="fa fa-facebook"></i></a>
                                <a href="#" class="twitter"><i class="fa fa-twitter"></i></a>
                                <a href="#" class="google-plus"><i class="fa fa-google-plus"></i></a>
                                <a href="#" class="pinterest"><i class="fa fa-pinterest"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <section>
                <header>
                    <h2 class="section-title">Similiar Categories of Movie</h2>
                </header>
                <div class="product-list">
                    @foreach (var item in Model.SameCategories)
                    {
                        <div class="product">
                        <div class="inner-product">
                            <div class="figure-image">
                                <img src="~/img/movie_imgs/@item.MainImg" alt="@item.Name">
                            </div>
                            <h3 class="product-title"><a href="#">@item.Name</a></h3>
                            <small class="price">@item.Price.ToString("c")</small>
                            <p>@item.Description</p>
                            <a href="#" class="button">Add to cart</a>
                            <a href="/Customer/Home/Details/@item.Id" class="button muted">Read Details</a>
                        </div>
                    </div> <!-- .product -->
                    }
                </div> <!-- .product-list -->
            </section>

            <section>
                <header>
                    <h2 class="section-title">Related Movie</h2>
                </header>
                <div class="product-list">
                    @foreach (var item in Model.RelatedMovies)
                    {
                    <div class="product">
                        <div class="inner-product">
                            <div class="figure-image">
                                <img src="~/img/movie_imgs/@item.MainImg" alt="@item.Name">
                            </div>
                            <h3 class="product-title"><a href="#">@item.Name</a></h3>
                            <small class="price">@item.Price.ToString("c")</small>
                            <p>@item.Description</p>
                            <a href="#" class="button">Add to cart</a>
                            <a href="/Customer/Home/Details/@item.Id" class="button muted">Read Details</a>
                        </div>
                    </div> <!-- .product -->
                    }
                    </div> <!-- .product-list -->
            </section>


        </div>
    </div> <!-- .container -->
</main> <!-- .main-content -->